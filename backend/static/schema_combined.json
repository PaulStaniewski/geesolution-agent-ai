        "/chat-stream/": {
            "get": {
                "summary": "Streamed Chat Response (Haystack + OpenAI)",
                "description": "\n                Asynchronously streams a chatbot response character by character.\n\n                This endpoint is powered by a hybrid pipeline using:\n                - PgVector Document Store for semantic search.\n                - SentenceTransformersTextEmbedder for embedding user questions.\n                - PgvectorEmbeddingRetriever for retrieving relevant documents.\n                - DocumentJoiner for combining retrieved documents.\n                - ChatPromptBuilder for generating a structured prompt.\n                - OpenAIChatGenerator for generating responses.\n            ",
                "parameters": [
                    {
                        "name": "message",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "User's input message."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Streamed chatbot response.",
                        "content": {
                            "text/event-stream": {
                                "example": "data: Hello\n\ndata: [DONE]\n\n"
                            }
                        }
                    }
                }
            }
        },
        "/document-parse/": {
            "post": {
                "summary": "Document Parsing (PDF, TXT, DOCX)",
                "description": "\n                Parses uploaded documents (PDF, TXT, DOCX) into a list of Haystack Document objects.\n\n                Supported file types:\n                - PDF (.pdf) - processed using PDFMinerToDocument.\n                - Text (.txt) - processed using TextFileToDocument.\n                - Word (.docx) - processed using DOCXToDocument.\n\n                How it works:\n                - User uploads a document.\n                - The document is converted into Haystack Document objects.\n                - Each document object retains metadata (file name).\n            ",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "The file to be parsed (PDF, TXT, DOCX)."
                                    }
                                },
                                "required": [
                                    "file"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "List of parsed document objects.",
                        "content": {
                            "application/json": {
                                "example": {
                                    "documents": [
                                        {
                                            "content": "Document text content...",
                                            "meta": {
                                                "file_name": "example.pdf"
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Error - Unsupported file type.",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Unsupported file type: .xyz"
                                }
                            }
                        }
                    }
                }
            }
        }
