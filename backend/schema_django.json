                        "cookieAuth": []
                    },
                    {
                        "basicAuth": []
                    },
                    {}
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/documents/delete-all/": {
            "delete": {
                "operationId": "api_documents_delete_all_destroy",
                "description": "API view to delete documents from the database and their corresponding vector entries from PgVector.\n- DELETE /api/documents/?all=true - Deletes all documents and their vector entries.\n- DELETE /api/documents/<doc_id>/ - Deletes a specific document and its vector entries.",
