    "components": {
        "schemas": {
            "Conversation": {
                "type": "object",
                "description": "Serializer for the Conversation model.\n- Serializes conversation data for API responses.\n- Allows creating and updating conversation records.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 255
                    },
                    "started_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "required": [
                    "id",
                    "started_at"
                ]
            },
            "Document": {
                "type": "object",
                "description": "Serializer for the Document model.\n- Serializes document data for API responses.\n- Allows creating and updating document records.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "file": {
                        "type": "string",
                        "format": "uri"
                    },
                    "uploaded_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "file",
                    "id",
                    "title",
                    "uploaded_at"
                ]
            },
            "Message": {
                "type": "object",
                "description": "Serializer for the Message model.\n- Serializes message data for API responses.\n- Ensures that each message is associated with a conversation.\n- Allows creating and updating message records.\n\nExtra validation:\n- The 'conversation' field is required.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "conversation": {
                        "type": "integer"
                    },
                    "user_message": {
                        "type": "string"
                    },
                    "bot_reply": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "bot_reply",
                    "conversation",
                    "created_at",
                    "id",
                    "user_message"
                ]
            },
            "PatchedConversation": {
                "type": "object",
                "description": "Serializer for the Conversation model.\n- Serializes conversation data for API responses.\n- Allows creating and updating conversation records.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 255
                    },
                    "started_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                }
            }
        },
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            }
        }
    }
}