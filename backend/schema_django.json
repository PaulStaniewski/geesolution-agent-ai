            "post": {
                "operationId": "api_messages_create",
                "description": "Creates a new message within a specific conversation.\n- Requires 'user_message', 'bot_reply', and 'conversation_id' in request data.\n- Automatically updates the conversation's 'updated_at' field.",
                "tags": [
                    "api"
