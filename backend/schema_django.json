                                        "$ref": "#/components/schemas/Conversation"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "api_conversations_create",
                "description": "API view for listing and creating conversations.\n- GET: Returns a list of all conversations ordered by their start date (newest first).\n- POST: Creates a new conversation.",
