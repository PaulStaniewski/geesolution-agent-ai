{
    "openapi": "3.0.3",
    "info": {
        "title": "GeeBOT API Documentation",
        "version": "1.0.0",
        "description": "Comprehensive API documentation for GeeBOT, an advanced chatbot system with document-based knowledge and general knowledge support."
    },
    "paths": {
        "/api/chat/": {
            "post": {
                "operationId": "api_chat_create",
                "description": "API view to handle user messages in a chatbot conversation.\n- Receives a user message and bot reply.\n- Saves the message to the database under the specified conversation.\n- Automatically updates the 'updated_at' field of the conversation.",
                "tags": [
                    "api"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Message"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/Message"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Message"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "cookieAuth": []
                    },
                    {
                        "basicAuth": []
                    },
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Message"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
