# =====================
# Core / Environment
# =====================

DEBUG=True
TIME_ZONE=UTC

# =====================
# OpenAI
# =====================

OPENAI_API_KEY=
OPENAI_TIMEOUT=45

# =====================
# Database
# =====================

DB_NAME=agentaidatabase
DB_USER=postgres
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432

# =====================
# Django / Auth
# =====================

DJANGO_SECRET_KEY=
SIMPLE_JWT_SIGNING_KEY=

SIMPLE_JWT_ALGORITHM=HS256
SIMPLE_JWT_ISSUER=geebot-api
SIMPLE_JWT_AUDIENCE=geebot-web

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=False
JWT_BLACKLIST_AFTER_ROTATION=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,django

# =====================
# Frontend / CORS / CSRF
# =====================

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================
# Security
# =====================

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# =====================
# Email
# =====================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

DEFAULT_FROM_EMAIL=noreply@example.com

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# =====================
# Chat / RAG
# =====================

RETRIEVE_TOP_K=4
EMBEDDER_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# =====================
# Streaming
# =====================

MAX_PROMPT_CHARS=4000
SSE_FLUSH_MS=75

# =====================
# Upload
# =====================

DATA_UPLOAD_MAX_NUMBER_FILES=1000